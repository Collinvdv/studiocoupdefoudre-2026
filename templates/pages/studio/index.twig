{# ========================================================================== #}
{# Inheritance #}
{# ========================================================================== #}
{% extends "_base/layout" %}

{# ========================================================================== #}
{# Variables #}
{# ========================================================================== #}
{% set activePage = "studio" %}
{% set inverseColorScheme = true %}
{% set title = "Over Studio Coup de Foudre" %}

{# ========================================================================== #}
{# Content #}
{# ========================================================================== #}
{% block content %}
	{% cache globally using key 'single-studio' if not craft.app.config.general.devMode  %}
		<main class="l-container p-studio">
			<h2 class="p-studio__title">{{ entry.commonTitle }}</h2>

			{% if entry.studioParagraph1 %}
				<div class="p-studio__intro">
					{{ entry.studioParagraph1|markdown }}
				</div>
			{% endif %}

			{% if entry.studioParagraph2 %}
				<div class="p-studio__text">
					{{ entry.studioParagraph2|markdown }}
				</div>
			{% endif %}

			{% if entry.commonHeaderImage.one() %}
				<figure class="p-studio__figure">
					<img
						class="p-studio__image"
						src="{{ entry.commonHeaderImage.one().url }}"
						alt="Jente Van Pelt"
					/>

					<figcaption class="p-studio__caption">Jente Van Pelt</figcaption>
				</figure>
			{% endif %}
		</main>
	{% endcache %}

{% endblock %}
