{# ========================================================================== #}
{# Inheritance #}
{# ========================================================================== #}
{% extends "_base/layout" %}

{# ========================================================================== #}
{# Variables #}
{# ========================================================================== #}
{% set activePage = "studio" %}

{# ========================================================================== #}
{# Content #}
{# ========================================================================== #}
{% block content %}

	{% cache globally using key 'single-studio' if not craft.app.config.general.devMode  %}
		<section class="l-container l-split c-studio js-appear">
			{% if entry.commonHeaderImage.one() %}
				<div
					class="l-split__item c-studio__image"
					style="background-image: url({{entry.commonHeaderImage.one().url}})">
					<img
							class="u-hide"
							src="{{entry.commonHeaderImage.one().url}}"
							alt="Oeps, hier staat normaal een sfeerfoto!"
							title=""
					/>
				</div>
			{% endif %}

			<div class="l-split__item l-split__item--right c-studio__content">
				<h2 class="c-studio__title">{{ entry.commonTitle }}</h2>

				{% if entry.studioParagraph1 %}
					{{ entry.studioParagraph1|markdown }}
				{% endif %}

				{% if entry.studioQuote %}
					<blockquote class="c-quote c-studio__quote">
						{{ entry.studioQuote }}
					</blockquote>
				{% endif %}

				{% if entry.studioParagraph2 %}
					{{ entry.studioParagraph2|markdown }}
				{% endif %}
			</div>
		</section>
	{% endcache %}

{% endblock %}
