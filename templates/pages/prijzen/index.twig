{# ========================================================================== #}
{# Inheritance #}
{# ========================================================================== #}
{% extends "_base/layout" %}

{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set activePage = "prijzen" %}
{% set transform = {
		mode: 'fit',
		width: 800,
		height: 800,
		quality: 100,
		position: 'center-center'
	}
%}


{# ========================================================================== #}
{# Content #}
{# ========================================================================== #}
{% block content %}

	{% cache globally using key 'single-prijzen' if not craft.app.config.general.devMode  %}
		<section class="l-container js-appear">
			<header class="c-header s-wysiwyg-header">
				<h2 class="c-header__title">{{ entry.commonTitle }}</h2>

				{{ entry.commonDescription }}

				<div class="c-header__actions">
					<a class="c-button c-button--inverse" href="{{ entry.commonLink }}">
						{{entry.commonLink.label}}

						<svg class="c-button__icon" width="18" height="16" viewBox="0 0 18 16" fill="currentcolor" xmlns="http://www.w3.org/2000/svg">
							<path d="M0 7.704C0 5.52 0.528 4.392 2.664 4.224C4.44 4.128 6 4.656 8.448 4.656C9.264 4.656 9.432 4.344 9.432 3.936C9.432 3.504 9.192 3.24 8.4 3C7.584 2.736 7.272 2.328 7.272 1.656C7.272 0.623999 7.848 0 9.168 0C11.88 0 13.008 2.28 15.12 3.888C16.992 5.376 17.424 6.432 17.424 7.368C17.424 8.304 17.16 9.36 15.528 10.8C13.416 12.552 12.096 15.096 8.928 15.096C7.44 15.096 6.744 14.448 6.744 13.296C6.744 12.528 7.128 12.096 8.064 11.856C8.784 11.64 9.024 11.4 9.024 10.944C9.024 10.584 8.856 10.296 8.064 10.296C5.664 10.296 4.152 10.848 2.4 10.704C0.264 10.488 0 9.696 0 7.704Z"/>
						</svg>
					</a>
				</div>
			</header>

			<div class="c-prijzen">
				{% for item in entry.prices.all() %}
					<article class="c-prijs">
						{% if item.priceImage.one() %}
							<div
								class="c-prijs__image"
								style="background-image: url({{item.priceImage.one().getUrl(transform)}})">
								<img
									class="u-hide"
									src="{{item.priceImage.one().getUrl(transform)}}"
								/>
							</div>
						{% endif %}

						<h3 class="c-prijs__title">{{item.priceTitle}}</h3>

						<p class="c-prijs__meta">
							<span class="c-prijs__duration">{{item.priceDuration}}</span>

							<span class="c-prijs__amount">€ {{item.priceAmount}}</span>
						</p>

						{% if item.priceInfo %}
							<p class="c-prijs__info">{{item.priceInfo}}</p>
						{% endif %}
					</article>
				{% endfor %}
			</div>
		</section>
	{% endcache %}

{% endblock %}
