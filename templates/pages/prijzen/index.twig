{# ========================================================================== #}
{# Inheritance #}
{# ========================================================================== #}
{% extends "_base/layout" %}

{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set activePage = "prijzen" %}
{% set inverseColorScheme = true %}
{% set transform = {
		mode: 'fit',
		width: 800,
		height: 800,
		quality: 100,
		position: 'center-center'
	}
%}

{# ========================================================================== #}
{# Content #}
{# ========================================================================== #}
{% block content %}

	{% cache globally using key 'single-prijzen' if not craft.app.config.general.devMode  %}
		<section class="l-container js-appear">
			<header class="c-header s-wysiwyg-header">
				<h1 class="c-header__title">{{ entry.commonTitle }}</h1>

				{{ entry.commonDescription }}

				<div class="c-header__actions">
					{% include "/_components/button" with {
						link: entry.commonLink ?? null
					} only %}
				</div>
			</header>

			<div class="c-prijzen">
				{% for item in entry.prices.all() %}
					<article class="c-prijs">
						{% if item.priceImage.one() %}
							<div
								class="c-prijs__image"
								style="background-image: url({{item.priceImage.one().getUrl(transform)}})">
								<img
									class="u-hide"
									src="{{item.priceImage.one().getUrl(transform)}}"
								/>
							</div>
						{% endif %}

						<h3 class="c-prijs__title">{{item.priceTitle}}</h3>

						<p class="c-prijs__meta">
							<span class="c-prijs__duration">{{item.priceDuration}}</span>

							<span class="c-prijs__amount">€ {{item.priceAmount}}</span>
						</p>

						{% if item.priceInfo %}
							<p class="c-prijs__info">{{item.priceInfo}}</p>
						{% endif %}
					</article>
				{% endfor %}
			</div>
		</section>
	{% endcache %}

{% endblock %}
