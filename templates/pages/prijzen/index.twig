{# ========================================================================== #}
{# Inheritance #}
{# ========================================================================== #}
{% extends "_base/layout" %}

{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set activePage = "prijzen" %}
{% set title = "Prijzen" %}
{% set prices = entry.prices.all() ?? [] %}
{% set inverseColorScheme = true %}
{% set transform = {
		mode: 'fit',
		width: 800,
		height: 800,
		quality: 100,
		position: 'center-center'
	}
%}

{# ========================================================================== #}
{# Content #}
{# ========================================================================== #}
{% block content %}
	{% cache globally using key 'single-prijzen' if not craft.app.config.general.devMode  %}
		<main class="l-container p-prices">
			{% if entry.commonDescription %}
				<div class="p-prices__intro">
					{{ entry.commonDescription|markdown }}
				</div>
			{% endif %}

			<ul class="p-price__list">
				{% for item in prices %}
					<li class="c-price">
						<p class="c-price__meta">
							<strong class="c-price__title">{{item.priceTitle}}</strong>

							<span class="c-price__duration">{{item.priceDuration}}</span>
						</p>

						<p class="c-price__amount">{{item.priceAmount}}</p>
					</li>
				{% endfor %}
			</ul>
		</main>
	{% endcache %}
{% endblock %}
