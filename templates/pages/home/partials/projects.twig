{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set projects = section.sectionProjects
	.with(['commonHeaderImage'])
	.all() ?? []
%}

{% set transform = {
	mode: 'fit',
	width: 800,
	height: 800,
	quality: 100,
	position: 'center-center'
} %}

{# ========================================================================== #}
{# :: Component #}
{# ========================================================================== #}
{% if projects is not empty %}
	<section class="l-container c-spotlight">
		<h2 class="c-spotlight__title">
			Projecten in de spotlight
		</h2>

		<ul class="c-spotlight__portfolio c-portfolio">
			{% for album in projects %}
				{% set image = album.commonHeaderImage.one() ?? null %}
				{% set albumUrl = album.getUrl() ?? null %}
				{% set albumTitle = album.commonTitle ?? null %}
				{% set albumCategory = album.commonCategory ?? null %}

				<li class="c-portfolio__item">
					<a
						class="c-portfolio__item-link"
						href="{{ albumUrl }}"
					>
						<div class="c-portfolio__image-wrapper">
							<img
								class="c-portfolio__item-image"
								src="{{ image.getUrl(transform) }}" alt="{{ image.title }}"
							>
						</div>

						<span class="c-portfolio__item-wrapper">
							<span class="c-portfolio__item-title">
								{{albumTitle }}
							</span>

							<span class="c-portfolio__item-line"></span>

							{% if album.commonCategory %}
								<span class="c-portfolio__item-category">
									{{ albumCategory }}
								</span>
							{% endif %}
						</span>
					</a>
				</li>
			{% endfor %}
		</ul>
	</section>
{% endif %}