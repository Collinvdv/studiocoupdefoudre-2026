{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set title = data.sectionTitle ?? null %}
{% set description = data.sectionDescription ?? null %}
{% set link = data.sectionLink ?? null %}

{# ========================================================================== #}
{# :: Component #}
{# ========================================================================== #}
<section class="l-container c-home__cta">
	<div class="c-home__cta-content">
		<header class="c-home__cta-header">
			<h2 class="c-home__cta-title">
				{{ title }}
			</h2>
		</header>

		<div class="c-home__cta-description">
			{{ description }}
		</div>

		<div class="c-home__cta-actions">
			<a class="c-button" href="{{ link.getUrl() }}">
				{{ link.label }}

				<svg class="c-button__icon" width="18" height="16" viewBox="0 0 18 16" fill="currentcolor" xmlns="http://www.w3.org/2000/svg">
					<path d="M0 7.704C0 5.52 0.528 4.392 2.664 4.224C4.44 4.128 6 4.656 8.448 4.656C9.264 4.656 9.432 4.344 9.432 3.936C9.432 3.504 9.192 3.24 8.4 3C7.584 2.736 7.272 2.328 7.272 1.656C7.272 0.623999 7.848 0 9.168 0C11.88 0 13.008 2.28 15.12 3.888C16.992 5.376 17.424 6.432 17.424 7.368C17.424 8.304 17.16 9.36 15.528 10.8C13.416 12.552 12.096 15.096 8.928 15.096C7.44 15.096 6.744 14.448 6.744 13.296C6.744 12.528 7.128 12.096 8.064 11.856C8.784 11.64 9.024 11.4 9.024 10.944C9.024 10.584 8.856 10.296 8.064 10.296C5.664 10.296 4.152 10.848 2.4 10.704C0.264 10.488 0 9.696 0 7.704Z"/>
				</svg>
			</a>
		</div>
	</div>
</section>
