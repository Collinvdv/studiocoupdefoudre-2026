{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set title = section.sectionTitle ?? null %}
{% set description = section.sectionDescription ?? null %}
{% set linkPrimary = section.sectionLink ?? null %}
{% set linkSecondary = section.secondaryLink ?? null %}

{# ========================================================================== #}
{# :: Component #}
{# ========================================================================== #}
<section class="c-cta">
	<div class="c-cta__wrapper">
		{% if title %}
			<h2 class="c-cta__title">
				{{ title }}
			</h2>
		{% endif %}

		{% if description %}
			<div class="c-cta__description">
				{{ description|striptags }}
			</div>
		{% endif %}

		{% if linkPrimary or linkSecondary %}
			<div class="c-cta__actions">
				{% if linkPrimary %}
					{% include "/_components/button" with {
						link: linkPrimary
					} only %}
				{% endif %}

				{% if linkSecondary %}
					{% include "/_components/button" with {
						link: linkSecondary,
						modifiers: "c-button--outline"
					} only %}
				{% endif %}
			</div>
		{% endif %}
	</div>
</section>
