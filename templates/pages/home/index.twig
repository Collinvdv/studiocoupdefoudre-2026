{# ========================================================================== #}
{# Inheritance #}
{# ========================================================================== #}
{% extends "_base/layout" %}

{# ========================================================================== #}
{# Variables #}
{# ========================================================================== #}
{% set activePage = "home" %}
{% set footerType = "bubblegum" %}

{# ========================================================================== #}
{# Content #}
{# ========================================================================== #}
{% block content %}
	{% cache globally using key 'single-home' if not craft.app.config.general.devMode  %}
		<div class="c-home js-appear">
			{# HERO #}
			{# <div class="l-container@viewport-9">
				<div class="c-home__hero" style="background-image: url({{ entry.commonHeaderImage.one().url() ?? '' }})">
				</div>
			</div> #}

			{% for section in entry.homeBodyBlocks.all() %}
				{% if section.type == "mxHomeShootsBlock" %}
					{% include "pages/home/partials/projects.twig" with {
						data: section
					} only %}
				{% endif %}
			{% endfor %}

			{% if entry.homeQuote ?? null %}
				<div class="c-marquee">
					<blockquote class="c-marquee__track">
						{{entry.homeQuote|nl2br|replace("<br />", " •")}}
						<span> •</span>
						{{entry.homeQuote|nl2br|replace("<br />", " •")}}
						<span> •</span>
						{{entry.homeQuote|nl2br|replace("<br />", " •")}}
						<span> •</span>
					</blockquote>
				</div>
			{% endif %}

			{% for section in entry.homeBodyBlocks.all() %}
				{% if section.type == "mxHomeCta" %}
					{% include "pages/home/partials/cta.twig" with {
						data: section
					} only %}
				{% endif %}
			{% endfor %}
		</div>
	{% endcache %}
{% endblock %}
