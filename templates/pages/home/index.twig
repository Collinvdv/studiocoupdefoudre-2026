{# ========================================================================== #}
{# Inheritance #}
{# ========================================================================== #}
{% extends "_base/layout" %}

{# ========================================================================== #}
{# Variables #}
{# ========================================================================== #}
{% set activePage = "home" %}

{% set blocks = entry.homeBodyBlocks is defined
	? entry.homeBodyBlocks.type([
		'mxHomeShootsBlock',
		'mxHomeCta',
		'mxHomeMarqueeBanner'
	]).all()
	: []
%}

{# ========================================================================== #}
{# Content #}
{# ========================================================================== #}
{% block content %}
	{% cache globally using key 'single-home' if not craft.app.config.general.devMode  %}
		<div class="c-home">
			{% if blocks is not empty %}
				{% for section in blocks %}
					{% switch section.type %}
						{% case "mxHomeShootsBlock" %}
							{% include "pages/home/partials/projects.twig" with {
								section
							} only %}

						{% case "mxHomeCta" %}
							{% include "pages/home/partials/cta.twig" with {
								section
							} only %}

						{% case "mxHomeMarqueeBanner" %}
							{% include "pages/home/partials/banner.twig" with {
								section
							} only %}
					{% endswitch %}
				{% endfor %}
			{% endif %}
		</div>
	{% endcache %}
{% endblock %}
