{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set title = entry.commonTitle|default("") %}
{% set description = entry.commonDescription|default("") %}
{% set link = entry.commonLink ?? null %}

{# ========================================================================== #}
{# :: Component #}
{# ========================================================================== #}
<section class="c-cta">
	<div class="c-cta__wrapper">
		{% if title %}
			<h2 class="c-cta__title">
				{{ title }}
			</h2>
		{% endif %}

		{% if description %}
			<div class="c-cta__description">
				{{ description|striptags }}
			</div>
		{% endif %}


		{% if link %}
			<div class="c-cta__actions">
				{% include "/_components/button" with {
					link
				} only %}
			</div>
		{% endif %}
	</div>
</section>
