{# ========================================================================== #}
{# Inheritance #}
{# ========================================================================== #}
{% extends "_base/layout" %}

{# ========================================================================== #}
{# Variables #}
{# ========================================================================== #}
{% set transform = {
		mode: 'fit',
		width: 800,
		height: 800,
		quality: 100,
		position: 'center-center'
	}
%}

{% set activePage = "portfolio" %}

{# ========================================================================== #}
{# Content #}
{# ========================================================================== #}
{% block content %}
	{% cache globally using key 'single-porfolio' ~ entry.slug if not craft.app.config.general.devMode  %}
		<div class="l-container" data-slug="{{entry.slug}}">
			<h1 class="c-header__title u-visually-hidden">Portfolio</h1>

			{% if entry.projectAlbums and entry.projectAlbums|length > 0 %}
				<ul class="c-portfolio c-portfolio--large">
					{% for album in entry.projectAlbums.all()|reverse %}
						<li class="c-portfolio__item">
							<a
								class="c-portfolio__item-link"
								href="{{ album.getUrl() }}"
							>
								<div class="c-portfolio__image-wrapper">
									<img
										class="c-portfolio__item-image"
										src="{{ album.commonHeaderImage.one().getUrl(transform) }}" alt="{{ album.commonHeaderImage.one().title }}"
									>
								</div>

								<span class="c-portfolio__item-wrapper">
									<span class="c-portfolio__item-title">
										{{ album.commonTitle }}
									</span>

									<span class="c-portfolio__item-line"></span>

									{% if album.commonCategory %}
										<span class="c-portfolio__item-category">
											{{ album.commonCategory }}
										</span>
									{% endif %}
								</span>
							</a>
						</li>
					{% endfor %}
				</ul>
			{% else %}
				<p class="c-portfolio:empty">
					Ik ben momenteel alles mooi in albums aan het gieten! Kom later eens terug om ze in te kijken!
				</p>
			{% endif %}
		</div>

		{% include "pages/portfolio/partials/cta.twig" with {
			entry
		} only %}
	{% endcache %}
{% endblock %}
