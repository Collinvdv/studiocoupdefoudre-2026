{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set title = title ?? NULL %}
{% set description = description ?? NULL %}
{% set shapes = shapes ?? true %}

{# ========================================================================== #}
{# :: Component #}
{# ========================================================================== #}
<header class="l-header">
	{% if title %}
		<h1 class="u-hide">{{title}}</h1>
	{% endif %}

	{% include '/_components/nav' with {
		shapes
	} %}
</header>

