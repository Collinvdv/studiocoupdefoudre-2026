{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set url = url ?? link.getUrl() ?? '#' %}
{% set label = label ?? link.label ?? null %}
{% set modifiers = modifiers|default("") %}

{# ========================================================================== #}
{# :: Component #}
{# ========================================================================== #}
{% if label %}
	<a class="c-button {{ modifiers }}" href="{{ url }}">
		{{ label }}

		{{ svg('@templates/_svg/arrow-right.svg')|attr({
			class: 'c-button__icon'
		}) }}
	</a>
{% endif %}