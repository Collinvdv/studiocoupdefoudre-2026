{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set footerType = footerType ?? null %}

{# ========================================================================== #}
{# :: Component #}
{# ========================================================================== #}
<footer class="c-footer {% if footerType %}c-footer--{{footerType}}{% endif %}">
	<div class="l-container c-footer__content">
		<h2 class="u-visually-hidden">Footer</h2>

		<p class="c-footer__text">&#169; {{ "now"|date("Y") }} | Studio Coup De Foudre</p>

		<p class="u-visually-hidden">A website made by
			<a href="https://sjouwke.be" class="c-link" target="_blank">Sjouwke Van Parys</a>
		</p>

		{% include "/_components/socials.twig" with {
			classes: "c-footer__socials"
		} only %}
	</div>
</footer>
