		<ul class="c-nav__list">
			<li class="c-nav__item  {% if activePage == "portfolio" %} is-active{% endif %}">
				<a href="/portfolio"
					class="c-nav__link">Portfolio</a>
			</li>

			<li class="c-nav__item  {% if activePage == "prijzen" %} is-active{% endif %}">
