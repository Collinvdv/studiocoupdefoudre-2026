{# ========================================================================== #}
{# :: Variables #}
{# ========================================================================== #}
{% set matrixBlocks = matrixBlocks ?? NULL %}

{# ========================================================================== #}
{# :: Modular body #}
{# ========================================================================== #}
{% for item in matrixBlocks.all() %}
	{% switch item.type %}
		{% case "textBlock" %}
			{% include "_matrix/_blocks/text.twig" with
				{
					item : item
				}
			only %}
	{% endswitch %}
{% endfor %}