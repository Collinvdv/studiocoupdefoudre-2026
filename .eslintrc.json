{
	"env": {
		"browser": true,
		"node": true,
		"es6": true
	},
	"extends": "eslint:recommended",
	"parserOptions": {
		"sourceType": "module"
	},
	"parser": "babel-eslint",
	"rules": {
		"semi": ["warn", "always"],
		"no-console": "warn",
		"no-await-in-loop": "error",
		"no-extra-parens": "error",
		"no-template-curly-in-string": "error",
		"complexity": ["warn", 5],
		"curly": "error",
		"default-case": "error",
		"eqeqeq": "error",
		"no-alert": "error",
		"no-caller": "error",
		"max-classes-per-file": ["error", 1],
		"no-empty-function": "error",
		"no-eq-null": "error",
		"no-eval": "error",
		"no-extra-label": "error",
		"no-implied-eval": "error",
		"no-labels": "error",
		"no-lone-blocks": "error",
		"no-magic-numbers": "off",
		"no-multi-spaces": "error",
		"no-new-func": "error",
		"no-return-await": "error",
		"no-self-compare": "error",
		"no-useless-return": "error",
		"no-void": "error",
		"require-await": "error",
		"init-declarations": ["error", "always"],
		"no-label-var": "error",
		"no-undef-init": "error",
		"array-bracket-spacing": ["error", "never"],
		"brace-style": "warn",
		"comma-dangle": ["warn", "always-multiline"],
		"comma-spacing": [
		"warn",
		{
			"before": false,
			"after": true
		}
		],
		"implicit-arrow-linebreak": ["error", "beside"],
		"key-spacing": [
		"warn",
		{
			"beforeColon": false,
			"afterColon": true,
			"mode": "strict"
		}
		],
		"keyword-spacing": [
		"warn",
		{
			"before": true,
			"after": true
		}
		],
		"max-depth": ["warn", 3],
		"max-len": [
			"warn", {
				"comments": 80,
				"ignoreStrings": true,
				"ignoreTemplateLiterals": true,
				"ignoreRegExpLiterals": true
			}
		],
		"max-lines": [
		"warn",
		{
			"skipComments": true,
			"max": 300
		}
		],
		"no-lonely-if": "error",
		"no-mixed-operators": "off",
		"no-multi-assign": "error",
		"no-multiple-empty-lines": [
		"error",
		{
			"max": 1,
			"maxEOF": 1
		}
		],
		"no-trailing-spaces": [
		"error", { "skipBlankLines": true }],
		"no-whitespace-before-property": "error",
		"object-curly-spacing": ["error", "always"],
		"prefer-object-spread": "warn",
		"quotes": ["error", "double"],
		"no-duplicate-imports": "error",
		"no-useless-constructor": "error",
		"prefer-spread": "warn",
		"template-curly-spacing": ["error", "never"]
	},
	"globals": {
		"TimelineLite": false,
		"TimelineMax": false,
		"TweenLite": false,
		"TweenMax": false,
		"Back": false,
		"Bounce": false,
		"Circ": false,
		"Cubic": false,
		"Ease": false,
		"EaseLookup": false,
		"Elastic": false,
		"Expo": false,
		"Linear": false,
		"Power0": false,
		"Power1": false,
		"Power2": false,
		"Power3": false,
		"Power4": false,
		"CustomEase": false,
		"Quad": false,
		"Quart": false,
		"Quint": false,
		"RoughEase": false,
		"Sine": false,
		"SlowMo": false,
		"SteppedEase": false,
		"Strong": false,
		"Draggable": false,
		"SplitText": false,
		"VelocityTracker": false,
		"CSSPlugin": false,
		"ThrowPropsPlugin": false,
		"BezierPlugin": false,
		"Glide": true,
		"SmoothScroll": false
	}
}
