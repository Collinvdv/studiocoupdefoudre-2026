# Craft .gitignore
#
# Example .gitignore file for Craft CMS projects
#
# @author    nystudio107
# @copyright Copyright (c) 2017 nystudio107
# @link      https://nystudio107.com/
# @package   craft-scripts
# @since     1.1.0
# @license   MIT

# This file should be renamed to '.gitignore' and placed in your
# Craft CMS project root directory

# CRAFT ENVIRONMENT
.env.php
.env.sh
.env

# DDEV
.ddev/.gitignore
.ddev/commands/*
!.ddev/commands/.gitkeep
.ddev/homeadditions
.ddev/import-db
.ddev/.ddev-docker-compose-*
.ddev/db_snapshots
.ddev/sequelpro.spf
.ddev/import.yaml
.ddev/.global_commands
.ddev/config.*.yaml

# COMPOSER
/vendor

# CRAFT STORAGE
/craft/storage/*
/storage/*

# ASSETS
/public/assets/*
/public/uploads/**/*
/web/assets/*
/web/assets/uploads/**/*
/web/uploads/**/*
/web/cpresources/**/*


# IMAGER TRANSFORMS
/public/imager/*
/web/imager/*

# BUILD FILES
/bower_components/*
/node_modules/*
/build/*
/yarn-error.log

#/templates/shop/

# MISC FILES
.cache
.DS_Store
.idea
.project
.settings
*.esproj
*.sublime-workspace
*.sublime-project
*.tmproj
*.tmproject
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
config.codekit3
prepros-6.config

package-lock.json
composer.lock
config/license.key